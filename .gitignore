# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local variable files can hold subscription, tenant and management group IDs.
*.tfvars
*.tfvars.json
!terraform/environments/*.tfvars
!**/*.tfvars.example

# Bicep and ARM build output
*.json.bak
bicep/*.json

# Python
__pycache__/
*.pyc
.venv/

# Terraform backend settings for your own state storage
backend.hcl
*.backend.hcl

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# .terraform.lock.hcl is committed on purpose: it pins the tested provider versions and
# carries checksums for linux_amd64, windows_amd64, darwin_amd64 and darwin_arm64.

