{
  "initiative": {
    "name": "ojk-fsi-checklist-2026-03",
    "displayName": "OJK FSI Checklist (Mar 2026) - technical controls for Azure and Azure Arc",
    "description": "Bank-side technical controls derived from Microsoft's compliance and contract checklist for financial institutions in Indonesia (March 2026). Covers Azure resources, Azure Arc-enabled servers (Windows/Linux, SQL Server) and Azure Arc-enabled Kubernetes. Contractual and Microsoft-side items are not policy-enforceable; see mapping/checklist-coverage.csv. SEOJK 21/2017 references are as cited in the checklist; PADK OJK 1/2026 replaced SEOJK 21/2017 on 1 March 2026.",
    "metadata": {
      "version": "1.1.0",
      "category": "Regulatory Compliance",
      "source": "Microsoft - Checklist for Financial Institutions in Indonesia (March 2026): Part 2 Sections A-I, B-I, B-II and Part 3 Sections I-II (Banks)",
      "regulatoryNote": "POJK 11/2022 is the primary reference. The checklist also cites OJK Circular Letter 21/SEOJK.03/2017, which PADK OJK 1/2026 replaced on 1 March 2026. Re-map those references to PADK 1/2026 Lampiran I with your compliance team before you use the results as audit evidence.",
      "builtInsVerifiedOn": "2026-10-01"
    },
    "parameters": {
      "listOfAllowedLocations": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed locations",
          "description": "Regions allowed for resources and resource groups. Azure Arc-enabled servers and Kubernetes clusters store their metadata in the region chosen at onboarding.",
          "strongType": "location"
        },
        "defaultValue": [
          "indonesiacentral"
        ]
      },
      "allowedAiDeploymentTypes": {
        "type": "Array",
        "metadata": {
          "displayName": "Approved AI deployment types",
          "description": "Foundry and Azure OpenAI deployment sku.name values whose processing location is approved. Add DataZone* or Global* only after the bank approves processing outside Indonesia."
        },
        "defaultValue": [
          "Standard",
          "ProvisionedManaged"
        ]
      },
      "effectDataLocation": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - data location",
          "description": "Effect for location and AI deployment type controls."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectPreventive": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - preventive controls",
          "description": "Effect for configuration controls that support Deny."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectDetective": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - detective controls",
          "description": "Effect for AuditIfNotExists controls (Defender plans, agents, logs, baselines)."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "effectKubernetes": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - Kubernetes workloads",
          "description": "Effect for Kubernetes controls on AKS and Azure Arc-enabled Kubernetes (Gatekeeper). Requires the Azure Policy extension on Arc-enabled clusters."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectCustomerManagedKey": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - customer-managed keys",
          "description": "Audit or Disabled. Data at rest is always encrypted with Microsoft-managed keys; CMK is a bank policy decision."
        },
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "effectResilience": {
        "type": "String",
        "metadata": {
          "displayName": "Effect - zone resilience",
          "description": "Effect for zone-redundancy controls (preview built-ins)."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "includeArcMachines": {
        "type": "String",
        "metadata": {
          "displayName": "Include Azure Arc-enabled servers",
          "description": "Include Arc-enabled (on-premises or other cloud) machines in machine configuration audits."
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "diagnosticSettingsResourceTypes": {
        "type": "Array",
        "metadata": {
          "displayName": "Resource types that need diagnostic settings",
          "description": "Resource types audited for diagnostic settings (logs and metrics).",
          "strongType": "resourceTypes"
        },
        "defaultValue": [
          "Microsoft.ApiManagement/service",
          "Microsoft.ContainerService/managedClusters",
          "Microsoft.Network/applicationGateways",
          "Microsoft.Network/azureFirewalls",
          "Microsoft.Web/sites"
        ]
      },
      "serviceHealthAlertResourceGroupName": {
        "type": "String",
        "metadata": {
          "displayName": "Service Health alert resource group",
          "description": "Resource group in each subscription where the Service Health alert rule is expected."
        },
        "defaultValue": "rg-serviceHealthAlert"
      }
    }
  },
  "groups": [
    {
      "name": "OJK-01-DATA-LOCATION",
      "displayName": "OJK-01 Data location and placement of electronic systems",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Keeps Azure resources, Azure Arc metadata and AI inference processing in approved locations. POJK 11/2022 Art. 35 (data center and DRC in Indonesia; placement outside Indonesia needs OJK approval) and Art. 36. Checklist: Part 2 A-I #1 (DC/DRC location), B-I #5 (offshore operation must not reduce OJK supervision), B-II #9 (temporary offshore placement and re-placement plan, POJK 11/2022 Art. 36(1)(j)). Use time-bound policy exemptions to record approved or temporary offshore placement."
    },
    {
      "name": "OJK-02-CONFIDENTIALITY",
      "displayName": "OJK-02 Confidentiality: encryption in transit and at rest",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Bank-side encryption settings on Azure, Arc-enabled Windows servers and Kubernetes. Checklist: Part 3 II POJK 11/2022 Art. 30(3)(b); SEOJK 21/2017 (as cited) 9.2.2(c)(4), (c)(10), (c)(12); Part 2 A-I #5(c). Microsoft-side commitments are in the DPA and FSA."
    },
    {
      "name": "OJK-03-NETWORK-ISOLATION",
      "displayName": "OJK-03 Data accessible only by the bank: network isolation",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Private connectivity and public network restrictions, including Azure Arc Private Link Scope for on-premises agents. Checklist: SEOJK 21/2017 (as cited) 9.2.2(c)(4) and (c)(10); Part 2 B-I #1(a)."
    },
    {
      "name": "OJK-04-IDENTITY-ACCESS",
      "displayName": "OJK-04 Authentication and least privilege",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "MFA for Azure management, owner hygiene, local-authentication removal and Kubernetes token hygiene. Checklist: SEOJK 21/2017 (as cited) 9.2.2(c)(4); Part 2 A-I #5(c). Conditional Access and PIM are configured in Microsoft Entra, not Azure Policy."
    },
    {
      "name": "OJK-05-SECURITY-BASELINE",
      "displayName": "OJK-05 System security standards and hardening",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Security baselines for Azure VMs, Arc-enabled Windows and Linux servers, and Kubernetes workloads on AKS or Arc-enabled clusters. Checklist: SEOJK 21/2017 (as cited) 9.2.2(c)(24); Part 2 B-II #6(c) (monitoring compliance with information security requirements)."
    },
    {
      "name": "OJK-06-PATCH-VULNERABILITY",
      "displayName": "OJK-06 Security updates and vulnerability remediation",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Update assessment, missing updates and SQL Server vulnerability findings on Azure VMs and Arc-enabled servers. Checklist: SEOJK 21/2017 (as cited) 9.2.2(c)(24); Part 2 B-II #6(c)."
    },
    {
      "name": "OJK-07-MONITORING-INCIDENT",
      "displayName": "OJK-07 Security monitoring, logging and incident alerting",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Defender plans, security contacts, Azure Monitor Agent and resource logs that support critical-incident reporting. Checklist: Part 2 A-I #7 (monitoring plan), B-II #1 (POJK 11/2022 Art. 29(2)); Part 3 Art. 30(3)(e); SEOJK 21/2017 (as cited) 9.2.2(c)(15), 9.2.3(f)(2)(iii), 9.2.3(f)(3)."
    },
    {
      "name": "OJK-08-PROVIDER-MONITORING",
      "displayName": "OJK-08 Monitoring of cloud service performance and continuity",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Service Health alerting for Microsoft service issues and planned maintenance. Checklist: Part 2 B-I #2 (POJK 11/2022 Art. 30(5)(a)), B-II #7(a) and (c); SEOJK 21/2017 (as cited) 9.2.2(c)(7), 9.2.3(f)(2)(i)."
    },
    {
      "name": "OJK-09-BACKUP-RESILIENCE",
      "displayName": "OJK-09 Backup, key protection and in-country resilience",
      "category": "OJK FSI Checklist (Mar 2026)",
      "description": "Backup, Key Vault recovery settings and zone redundancy. Indonesia Central has no paired region, so availability zones keep replicas in Indonesia; replication to another region is an offshore DRC placement. Checklist: Part 2 B-II #6(b), A-I #2(n); SEOJK 21/2017 (as cited) 9.2.2(c)(11), 9.2.3(f)(4)."
    }
  ],
